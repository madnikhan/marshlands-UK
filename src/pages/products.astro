---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionMedia from '../components/SectionMedia.astro';
import { company } from '../data/company';
import { expandingRangeNote, products } from '../data/products';
---

<BaseLayout
  title="Our Products"
  description="Shop the MARSHLAND kitchen range on Amazon UK — salt and pepper grinders, tin openers, peelers, garlic presses, and more practical cooking tools."
  canonicalPath="/products"
>
  <section class="page-banner">
    <img
      src="/images/section-categories.jpg"
      alt=""
      class="banner-img"
      loading="eager"
      decoding="async"
    />
    <div class="banner-scrim"></div>
    <div class="container page-hero reveal">
      <span class="eyebrow">Our Products</span>
      <h1>Kitchen tools for everyday cooking</h1>
      <hr class="divider" />
      <p class="lead">
        Shop the full MARSHLAND kitchen range on Amazon UK — practical, stylish tools designed to make
        meal prep cleaner, faster, and more enjoyable.
      </p>
      <div class="btn-group">
        <a class="btn btn--primary" href={company.amazonStoreUrl} target="_blank" rel="noopener noreferrer">
          Visit Amazon store
        </a>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container reveal">
      <h2>Current catalogue</h2>
      <hr class="divider" />
      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container expanding-grid reveal">
      <SectionMedia
        src="/images/range-kitchen.jpg"
        alt="MARSHLAND kitchen tools available on Amazon"
      />
      <div>
        <span class="eyebrow">Expanding range</span>
        <h2>More tools. More opportunity.</h2>
        <hr class="divider" />
        <p class="lead">{expandingRangeNote}</p>
        <p>
          If you manufacture or distribute kitchen and lifestyle products that align with the
          MARSHLAND standard, we would like to hear from you.
        </p>
        <div class="btn-group">
          <a class="btn btn--primary" href="/partner">Partner with MARSHLAND</a>
          <a class="btn btn--secondary" href="/contact">Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 22rem;
    display: flex;
    align-items: flex-end;
  }

  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .banner-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--cream-light) 94%, transparent) 0%,
      color-mix(in srgb, var(--cream-light) 70%, transparent) 55%,
      color-mix(in srgb, var(--cream-light) 35%, transparent) 100%
    );
  }

  .page-hero {
    padding: clamp(4rem, 10vw, 6rem) 0 var(--space-lg);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin-top: 1.75rem;
  }

  .expanding-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .expanding-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
