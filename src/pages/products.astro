---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { company } from '../data/company';
import { expandingRangeNote, products } from '../data/products';

const rangePillars = [
  {
    title: 'Kitchen',
    body: 'Practical tools, food preparation, cooking and everyday kitchen essentials.',
  },
  {
    title: 'Home',
    body: 'Useful, well-considered products for everyday living, organisation and the modern household.',
  },
  {
    title: 'New Categories',
    body: 'Carefully selected opportunities that complement the MARSHLAND brand and meet genuine customer needs.',
  },
];
---

<BaseLayout
  title="Our Products"
  description="Thoughtful Home & Kitchen products from MARSHLAND — practical kitchen essentials on Amazon UK, with a broader range for modern living in development."
  canonicalPath="/products"
>
  <section class="page-banner">
    <img
      src="/images/section-categories.jpg"
      alt=""
      class="banner-img"
      loading="eager"
      decoding="async"
    />
    <div class="banner-scrim"></div>
    <div class="container page-hero reveal">
      <span class="eyebrow">Our Products</span>
      <h1>Thoughtful products for modern living.</h1>
      <hr class="divider" />
      <p class="lead">
        At MARSHLAND, we believe the products we use every day should be practical, dependable and
        thoughtfully designed.
      </p>
      <p>
        Our journey began in the kitchen, with a growing collection of everyday essentials designed
        around functionality, quality and ease of use. Now, we're taking that same approach further —
        developing MARSHLAND into a broader Home & Kitchen brand with products designed to make
        everyday living simpler and better.
      </p>
      <div class="btn-group">
        <a class="btn btn--primary" href={company.amazonStoreUrl} target="_blank" rel="noopener noreferrer">
          Visit Amazon store
        </a>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container reveal">
      <span class="eyebrow">Current collection</span>
      <h2>Kitchen essentials for everyday life.</h2>
      <hr class="divider" />
      <p class="lead">
        Our current collection brings together practical kitchen tools designed to perform reliably,
        feel comfortable to use and fit naturally into the modern home.
      </p>
      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <span class="eyebrow">The MARSHLAND range</span>
      <h2>From kitchen essentials to the wider home.</h2>
      <hr class="divider" />
      <p class="lead">{expandingRangeNote}</p>
      <p>
        As the brand grows, our focus is not simply on adding more products. It's on identifying the
        right products — products that solve everyday needs, complement the MARSHLAND range and earn a
        place in our customers' homes.
      </p>

      <div class="pillar-grid">
        {
          rangePillars.map((pillar) => (
            <article class="pillar">
              <h3>{pillar.title}</h3>
              <hr class="divider divider--mist" />
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
      <p class="range-note">Our range will continue to evolve as MARSHLAND grows.</p>
    </div>
  </section>

  <section class="section section--maroon">
    <div class="container supplier-cta reveal">
      <span class="eyebrow">Manufacturers & suppliers</span>
      <h2>Have a product that belongs in the MARSHLAND range?</h2>
      <p class="lead">
        We're actively building relationships with experienced manufacturers, OEM & ODM partners and
        suppliers across Home & Kitchen and complementary consumer categories.
      </p>
      <p>
        We're interested in more than simply adding products to a catalogue. We want to work with
        capable partners who understand quality, product development, reliable manufacturing and the
        value of building a long-term relationship.
      </p>
      <p>
        If you manufacture an established product with strong market potential, have an innovative
        product concept, or believe your capabilities could complement the growing MARSHLAND
        portfolio, we'd be pleased to start a conversation.
      </p>
      <div class="btn-group">
        <a class="btn btn--ghost" href="/partner">Partner With MARSHLAND</a>
        <a class="btn btn--ghost" href="/contact">Contact Our Team</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 22rem;
    display: flex;
    align-items: flex-end;
  }

  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .banner-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--cream-light) 94%, transparent) 0%,
      color-mix(in srgb, var(--cream-light) 70%, transparent) 55%,
      color-mix(in srgb, var(--cream-light) 35%, transparent) 100%
    );
  }

  .page-hero {
    padding: clamp(4rem, 10vw, 6rem) 0 var(--space-lg);
    max-width: 46rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin-top: 1.75rem;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin-top: 2.25rem;
  }

  .pillar h3 {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--maroon);
  }

  .pillar p {
    margin: 0;
    color: var(--ink-soft);
  }

  .range-note {
    margin-top: 1.75rem;
    color: var(--ink-soft);
  }

  .supplier-cta {
    max-width: 44rem;
  }

  .supplier-cta .eyebrow {
    color: var(--cream);
  }

  .supplier-cta h2,
  .supplier-cta p {
    color: var(--white);
  }

  .supplier-cta .lead {
    color: color-mix(in srgb, var(--white) 88%, var(--cream));
  }

  @media (max-width: 900px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
