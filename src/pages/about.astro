---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMedia from '../components/SectionMedia.astro';
import { company } from '../data/company';
---

<BaseLayout
  title="About"
  description="Discover the MARSHLAND story — a UK kitchen brand creating practical, stylish tools that make everyday cooking more efficient and enjoyable."
  canonicalPath="/about"
>
  <section class="page-banner">
    <img src="/images/section-about.jpg" alt="" class="banner-img" loading="eager" decoding="async" />
    <div class="banner-scrim"></div>
    <div class="container page-hero reveal">
      <span class="eyebrow">About MARSHLAND</span>
      <h1>Practical tools. Stylish kitchens.</h1>
      <hr class="divider" />
      <p class="lead">
        MARSHLAND is a United Kingdom kitchen brand bringing practical, well-made tools into everyday
        cooking — available to customers through our official Amazon store.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container story-grid reveal">
      <div>
        <h2>Our story</h2>
        <hr class="divider" />
        <p>
          MARSHLAND was born from a shared passion for creating practical and stylish solutions for
          everyday cooking. Inspired by a desire to make kitchens more efficient and enjoyable, we
          crafted a range of high-quality tools designed to enhance the cooking experience. Our
          journey began with a simple goal: to bring functionality and elegance to homes everywhere.
        </p>
        <p>
          From salt and pepper mills to peelers, tin openers, and garlic presses, every product is
          chosen to feel dependable in the hand and considered on the counter.
        </p>
      </div>
      <SectionMedia
        src="/images/story-kitchen.jpg"
        alt="MARSHLAND salt and pepper grinders in a warm kitchen setting"
      />
    </div>
  </section>

  <section class="section">
    <div class="container media-row reveal">
      <SectionMedia
        src="/images/range-kitchen.jpg"
        alt="MARSHLAND kitchen tools designed for everyday cooking"
      />
      <div>
        <span class="eyebrow">Looking ahead</span>
        <h2>A growing kitchen brand</h2>
        <hr class="divider" />
        <p class="lead">
          We are expanding our Amazon kitchen range while building relationships with manufacturers
          and distributors who share our standards for quality, reliability, and thoughtful design.
        </p>
        <p>
          As we explore new product lines — including through international sourcing partnerships —
          we remain focused on tools that make cooking simpler, cleaner, and more enjoyable.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container reveal">
      <span class="eyebrow">Leadership</span>
      <h2>Directors</h2>
      <hr class="divider" />
      <p class="lead">
        MARSHLAND is led by directors dedicated to building a professional UK brand with a growing
        international network.
      </p>

      <div class="directors">
        {
          company.directors.map((director) => (
            <article class="director">
              <h3>{director.name}</h3>
              <p class="title">{director.title}</p>
              <hr class="divider divider--mist" />
              <p>
                <a href={director.phoneHref}>{director.phone}</a>
              </p>
              <p>
                <a href={`mailto:${director.email}`}>{director.email}</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--maroon">
    <div class="container reveal">
      <h2>Partner with us</h2>
      <p class="lead">
        If you manufacture or distribute kitchen and lifestyle products that align with the MARSHLAND
        standard, we would welcome a conversation.
      </p>
      <div class="btn-group">
        <a class="btn btn--ghost" href="/partner">Become a Partner</a>
        <a class="btn btn--ghost" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 22rem;
    display: flex;
    align-items: flex-end;
  }

  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .banner-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--cream-light) 94%, transparent) 0%,
      color-mix(in srgb, var(--cream-light) 70%, transparent) 55%,
      color-mix(in srgb, var(--cream-light) 35%, transparent) 100%
    );
  }

  .page-hero {
    padding: clamp(4rem, 10vw, 6rem) 0 var(--space-lg);
  }

  .story-grid,
  .media-row,
  .directors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .directors {
    margin-top: 2rem;
    align-items: stretch;
  }

  .director {
    padding: 1.75rem;
    background: color-mix(in srgb, var(--white) 65%, var(--cream-light));
    border: 1px solid var(--border);
  }

  .title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--maroon);
  }

  .director a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .director a:hover {
    color: var(--maroon);
  }

  @media (max-width: 800px) {
    .story-grid,
    .media-row,
    .directors {
      grid-template-columns: 1fr;
    }
  }
</style>
