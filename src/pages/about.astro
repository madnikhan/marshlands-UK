---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMedia from '../components/SectionMedia.astro';
import { company } from '../data/company';

const values = [
  {
    title: 'Quality',
    lead: "Products we're proud to put our name on.",
    body: 'We look beyond appearance. Materials, construction, functionality, finish and consistency all contribute to a product customers can rely on.',
  },
  {
    title: 'Reliability',
    lead: 'Doing what we say, consistently.',
    body: 'We value dependable products, clear communication and partners who take the same responsible approach to doing business.',
  },
  {
    title: 'Partnership',
    lead: 'Better business is built together.',
    body: 'We believe the strongest supplier relationships go beyond individual orders. We want to build open, collaborative partnerships that create long-term value for everyone involved.',
  },
  {
    title: 'Continuous improvement',
    lead: 'There is always an opportunity to make something better.',
    body: "Whether it's the product, packaging, manufacturing process or customer experience, we believe small improvements can make a meaningful difference.",
  },
];
---

<BaseLayout
  title="About"
  description="MARSHLAND is a British home & kitchen brand focused on practical functionality, dependable quality and considered design for everyday living."
  canonicalPath="/about"
>
  <section class="page-banner">
    <img src="/images/section-about.jpg" alt="" class="banner-img" loading="eager" decoding="async" />
    <div class="banner-scrim"></div>
    <div class="container page-hero reveal">
      <span class="eyebrow">About MARSHLAND</span>
      <h1>Practical by nature. Considered by design.</h1>
      <hr class="divider" />
      <p class="lead">
        MARSHLAND is a British home & kitchen brand with a simple ambition: to make everyday products
        better.
      </p>
      <p>
        We focus on products that bring together practical functionality, dependable quality and
        considered design — products that work well, feel good to use and belong naturally in the
        modern home.
      </p>
      <p>
        Our growing range includes everyday kitchen essentials, with new products and categories in
        development as the MARSHLAND brand continues to grow.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container story-grid reveal">
      <div>
        <span class="eyebrow">Our approach</span>
        <h2>Everyday products, made better.</h2>
        <hr class="divider" />
        <p class="lead">We believe good products don't need to be complicated.</p>
        <p>
          They need to solve a real need, perform reliably and offer the right balance of function,
          quality, design and value.
        </p>
        <p>
          That thinking guides the products we bring to the MARSHLAND range and the partners we choose
          to work with.
        </p>
        <p>
          From materials and functionality to packaging and presentation, we're always looking for
          ways to improve the details that shape the customer experience.
        </p>
      </div>
      <SectionMedia
        src="/images/story-kitchen.jpg"
        alt="MARSHLAND salt and pepper grinders in a warm kitchen setting"
      />
    </div>
  </section>

  <section class="section">
    <div class="container media-row reveal">
      <SectionMedia
        src="/images/section-categories-kitchen.jpg"
        alt="MARSHLAND kitchen tools arranged as an expanding product range"
      />
      <div>
        <span class="eyebrow">Looking ahead</span>
        <h2>Building a brand for the long term.</h2>
        <hr class="divider" />
        <p class="lead">
          MARSHLAND began with kitchen essentials, but our ambitions extend beyond a single product
          category.
        </p>
        <p>
          We're building a broader portfolio of products for the home, guided by customer needs,
          market opportunities and a commitment to practical, well-considered design.
        </p>
        <p>
          Our products are currently available to customers across the UK through Amazon, while we
          continue to develop the MARSHLAND range and explore new products, categories and routes to
          market.
        </p>
        <p>
          Alongside this growth, we're building an international network of trusted manufacturers,
          suppliers and commercial partners who share our ambitions and can grow with us for the long
          term.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container reveal">
      <span class="eyebrow">What we value</span>
      <h2>The principles behind our products and partnerships.</h2>
      <hr class="divider" />

      <div class="values-grid">
        {
          values.map((value) => (
            <article class="value">
              <h3>{value.title}</h3>
              <p class="value-lead">{value.lead}</p>
              <hr class="divider divider--mist" />
              <p>{value.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <span class="eyebrow">Leadership</span>
      <h2>The people behind MARSHLAND.</h2>
      <hr class="divider" />
      <p class="lead">
        MARSHLAND is led by directors with a shared focus on building a trusted British brand,
        developing products customers value and creating strong, long-term relationships with our
        manufacturing and commercial partners.
      </p>

      <div class="directors">
        {
          company.directors.map((director) => (
            <article class="director">
              <h3>{director.name}</h3>
              <p class="title">{director.title}</p>
              <hr class="divider divider--mist" />
              <p>
                <a href={director.phoneHref}>{director.phone}</a>
              </p>
              <p>
                <a href={`mailto:${director.email}`}>{director.email}</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--maroon">
    <div class="container reveal">
      <span class="eyebrow">Partner with MARSHLAND</span>
      <h2>Let's build something valuable together.</h2>
      <p class="lead">Great products depend on great partnerships.</p>
      <p>
        We're always interested in meeting experienced manufacturers, OEM & ODM partners, suppliers
        and distributors who share our commitment to quality, reliability and continuous improvement.
      </p>
      <p>
        Whether you have established manufacturing capabilities, an innovative product opportunity or
        the expertise to help develop the next MARSHLAND product, we'd like to hear from you.
      </p>
      <div class="btn-group">
        <a class="btn btn--ghost" href="/partner">Become a Partner</a>
        <a class="btn btn--ghost" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 22rem;
    display: flex;
    align-items: flex-end;
  }

  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .banner-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--cream-light) 94%, transparent) 0%,
      color-mix(in srgb, var(--cream-light) 70%, transparent) 55%,
      color-mix(in srgb, var(--cream-light) 35%, transparent) 100%
    );
  }

  .page-hero {
    padding: clamp(4rem, 10vw, 6rem) 0 var(--space-lg);
    max-width: 46rem;
  }

  .story-grid,
  .media-row,
  .directors,
  .values-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .values-grid {
    margin-top: 2rem;
    align-items: stretch;
    gap: 1.75rem;
  }

  .value h3 {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--maroon);
  }

  .value-lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink);
  }

  .value p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }

  .directors {
    margin-top: 2rem;
    align-items: stretch;
  }

  .director {
    padding: 1.75rem;
    background: color-mix(in srgb, var(--white) 65%, var(--cream-light));
    border: 1px solid var(--border);
  }

  .title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--maroon);
  }

  .director a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .director a:hover {
    color: var(--maroon);
  }

  .section--maroon .eyebrow {
    color: var(--cream);
  }

  .section--maroon h2,
  .section--maroon p {
    color: var(--white);
  }

  .section--maroon .lead {
    color: color-mix(in srgb, var(--white) 88%, var(--cream));
  }

  @media (max-width: 800px) {
    .story-grid,
    .media-row,
    .directors,
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
