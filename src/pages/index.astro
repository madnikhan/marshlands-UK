---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import SectionMedia from '../components/SectionMedia.astro';
import ProductCard from '../components/ProductCard.astro';
import { company, heroSlides } from '../data/company';
import { products } from '../data/products';

const featured = products[0];
---

<BaseLayout
  title={company.brand}
  description="MARSHLAND — UK brand for quality consumer and lifestyle products. Shop on Amazon or partner with Al-Razaq UK Pvt Ltd."
  canonicalPath="/"
>
  <section class="home-hero">
    <HeroSlideshow slides={[...heroSlides]} />
    <div class="container hero-content">
      <h1 class="hero-brand hero-animate">{company.brand}</h1>
      <p class="hero-headline hero-animate-delay">{company.tagline}</p>
      <p class="hero-support hero-animate-delay-2">
        A United Kingdom brand delivering dependable consumer products to homes — and building
        serious partnerships with manufacturers and distributors worldwide across top-selling
        categories.
      </p>
      <div class="btn-group hero-animate-delay-2">
        <a class="btn btn--primary" href={company.amazonStoreUrl} target="_blank" rel="noopener noreferrer">
          Shop on Amazon
        </a>
        <a class="btn btn--secondary" href="/partner">Become a Partner</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="trust-strip reveal">
        <div class="trust-item">
          <strong>UK Registered</strong>
          <span>{company.legalName}</span>
        </div>
        <div class="trust-item">
          <strong>Amazon Brand</strong>
          <span>Trusted by customers across the UK</span>
        </div>
        <div class="trust-item">
          <strong>Open to Partners</strong>
          <span>Multi-category manufacturing & distribution</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid reveal">
      <div>
        <span class="eyebrow">Who we are</span>
        <h2>A UK brand built on quality and careful growth</h2>
        <hr class="divider" />
        <p class="lead">
          MARSHLAND is the trading brand of {company.legalName}. We focus on practical, well-made
          consumer and lifestyle products — starting with items customers rely on every day, and
          expanding into top-selling categories.
        </p>
        <p>
          As we grow our multi-category catalogue through international sourcing and partner
          relationships, we remain committed to professionalism, reliability, and long-term
          collaboration.
        </p>
        <a class="text-link" href="/about">Learn more about MARSHLAND</a>
      </div>
      <SectionMedia
        src="/images/section-about.jpg"
        alt="MARSHLAND UK brand — professional company atmosphere"
      />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container featured-grid reveal">
      <div>
        <span class="eyebrow">Featured product</span>
        <h2>Available now on Amazon</h2>
        <hr class="divider" />
        <p class="lead">
          Our current live range includes Premium Swivel Peelers — with more top-selling product
          lines on the way as we continue sourcing across categories.
        </p>
        <div class="btn-group">
          <a class="btn btn--primary" href="/products">View our products</a>
          <a class="btn btn--secondary" href={company.amazonStoreUrl} target="_blank" rel="noopener noreferrer">
            Amazon store
          </a>
        </div>
      </div>
      <ProductCard product={featured} featured />
    </div>
  </section>

  <section class="section">
    <div class="container categories-grid reveal">
      <SectionMedia
        src="/images/section-categories.jpg"
        alt="Diverse consumer product categories for MARSHLAND"
      />
      <div>
        <span class="eyebrow">Expanding catalogue</span>
        <h2>Open to top-selling product categories</h2>
        <hr class="divider" />
        <p class="lead">
          From home and lifestyle essentials to everyday consumer goods, MARSHLAND is building a
          broad catalogue guided by quality, demand, and trusted supply partnerships.
        </p>
        <a class="text-link" href="/products">See what’s live and what’s next</a>
      </div>
    </div>
  </section>

  <section class="section partner-band">
    <div class="partner-media" aria-hidden="true">
      <img src="/images/section-partner.jpg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="container partner-cta reveal">
      <span class="eyebrow">Partnerships</span>
      <h2>Looking to manufacture, supply, or distribute?</h2>
      <p class="lead">
        We welcome conversations with manufacturers, OEM/ODM partners, and distributors across
        product categories who share our standards. Let’s explore opportunities together.
      </p>
      <div class="btn-group">
        <a class="btn btn--ghost" href="/partner">Become a Partner</a>
        <a class="btn btn--ghost" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-content {
    padding: clamp(4rem, 12vw, 7rem) 0;
    max-width: 48rem;
  }

  .hero-brand {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.25rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
    color: var(--ink);
    text-transform: uppercase;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.5vw, 2.35rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0 0 1rem;
    max-width: 20ch;
  }

  .hero-support {
    max-width: 36rem;
    font-size: 1.125rem;
    margin: 0;
  }

  .about-grid,
  .featured-grid,
  .categories-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
  }

  .categories-grid {
    grid-template-columns: 0.95fr 1.05fr;
  }

  .text-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
    color: var(--maroon);
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .partner-band {
    position: relative;
    isolation: isolate;
    padding: var(--space-xl) 0;
    color: var(--white);
    overflow: hidden;
  }

  .partner-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .partner-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      105deg,
      color-mix(in srgb, var(--maroon) 92%, transparent) 0%,
      color-mix(in srgb, var(--maroon-deep) 78%, transparent) 100%
    );
  }

  .partner-cta {
    max-width: 42rem;
  }

  .partner-cta .eyebrow {
    color: var(--cream);
  }

  .partner-cta h2,
  .partner-cta p {
    color: var(--white);
  }

  .partner-cta .lead {
    color: color-mix(in srgb, var(--white) 88%, var(--cream));
  }

  @media (max-width: 900px) {
    .about-grid,
    .featured-grid,
    .categories-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
