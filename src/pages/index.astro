---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideoLoop from '../components/HeroVideoLoop.astro';
import SectionMedia from '../components/SectionMedia.astro';
import ProductTile from '../components/ProductTile.astro';
import { company, heroVideos } from '../data/company';
import { products } from '../data/products';
---

<BaseLayout
  title={company.brand}
  description="MARSHLAND — UK kitchen brand for practical, stylish cooking tools. Shop our Amazon range or partner with us."
  canonicalPath="/"
>
  <section class="home-hero">
    <HeroVideoLoop videos={[...heroVideos]} />
    <div class="container hero-content">
      <h1 class="hero-brand hero-animate">{company.brand}</h1>
      <p class="hero-headline hero-animate-delay">{company.tagline}</p>
      <p class="hero-support hero-animate-delay-2">
        A United Kingdom kitchen brand delivering practical, stylish cooking tools to homes — and
        building serious partnerships with manufacturers and distributors worldwide.
      </p>
      <div class="btn-group hero-animate-delay-2">
        <a class="btn btn--primary" href={company.amazonStoreUrl} target="_blank" rel="noopener noreferrer">
          Shop on Amazon
        </a>
        <a class="btn btn--secondary" href="/partner">Become a Partner</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="trust-strip reveal">
        <div class="trust-item">
          <strong>{company.trust.title}</strong>
          <span>{company.trust.subtitle}</span>
        </div>
        <div class="trust-item">
          <strong>Amazon Brand</strong>
          <span>Trusted by customers across the UK</span>
        </div>
        <div class="trust-item">
          <strong>Open to Partners</strong>
          <span>Kitchen tools & expanding categories</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid reveal">
      <div>
        <span class="eyebrow">Who we are</span>
        <h2>A UK kitchen brand built on quality and careful growth</h2>
        <hr class="divider" />
        <p class="lead">
          MARSHLAND creates practical, stylish tools for everyday cooking — from grinders and peelers
          to tin openers and garlic presses — available through our official Amazon store.
        </p>
        <p>
          As we grow our kitchen catalogue through international sourcing and partner relationships,
          we remain committed to professionalism, reliability, and long-term collaboration.
        </p>
        <a class="text-link" href="/about">Learn more about MARSHLAND</a>
      </div>
      <SectionMedia
        src="/images/story-kitchen.jpg"
        alt="MARSHLAND kitchen tools in a warm home kitchen"
      />
    </div>
  </section>

  <section class="section section--cream">
    <div class="container shop-range reveal">
      <div class="shop-intro">
        <span class="eyebrow">Shop the range</span>
        <h2>Available now on Amazon</h2>
        <hr class="divider" />
        <p class="lead">
          Explore our kitchen tools — designed to bring functionality and elegance into everyday
          cooking.
        </p>
      </div>

      <div class="tile-grid">
        {products.map((product) => <ProductTile product={product} />)}
      </div>

      <div class="btn-group shop-actions">
        <a class="btn btn--primary" href="/products">View our products</a>
        <a class="btn btn--secondary" href={company.amazonStoreUrl} target="_blank" rel="noopener noreferrer">
          Amazon store
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container categories-grid reveal">
      <SectionMedia
        src="/images/range-kitchen.jpg"
        alt="MARSHLAND expanding kitchen product range"
      />
      <div>
        <span class="eyebrow">Expanding catalogue</span>
        <h2>Building a broader kitchen range</h2>
        <hr class="divider" />
        <p class="lead">
          From essential prep tools to considered kitchen accessories, MARSHLAND is growing a
          catalogue guided by quality, everyday demand, and trusted supply partnerships.
        </p>
        <a class="text-link" href="/products">See what’s live and what’s next</a>
      </div>
    </div>
  </section>

  <section class="section partner-band">
    <div class="partner-media" aria-hidden="true">
      <img src="/images/section-partner.jpg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="container partner-cta reveal">
      <span class="eyebrow">Partnerships</span>
      <h2>Looking to manufacture, supply, or distribute?</h2>
      <p class="lead">
        We welcome conversations with manufacturers, OEM/ODM partners, and distributors across
        kitchen and lifestyle categories who share our standards. Let’s explore opportunities together.
      </p>
      <div class="btn-group">
        <a class="btn btn--ghost" href="/partner">Become a Partner</a>
        <a class="btn btn--ghost" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-content {
    padding: clamp(4rem, 12vw, 7rem) 0;
    max-width: 48rem;
  }

  .hero-brand {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.25rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
    color: var(--ink);
    text-transform: uppercase;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.5vw, 2.35rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0 0 1rem;
    max-width: 20ch;
  }

  .hero-support {
    max-width: 36rem;
    font-size: 1.125rem;
    margin: 0;
  }

  .about-grid,
  .categories-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
  }

  .categories-grid {
    grid-template-columns: 0.95fr 1.05fr;
  }

  .shop-intro {
    max-width: 40rem;
    margin-bottom: 2rem;
  }

  .tile-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .shop-actions {
    margin-top: 2rem;
  }

  .text-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
    color: var(--maroon);
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .partner-band {
    position: relative;
    isolation: isolate;
    padding: var(--space-xl) 0;
    color: var(--white);
    overflow: hidden;
  }

  .partner-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .partner-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      105deg,
      color-mix(in srgb, var(--maroon) 92%, transparent) 0%,
      color-mix(in srgb, var(--maroon-deep) 78%, transparent) 100%
    );
  }

  .partner-cta {
    max-width: 42rem;
  }

  .partner-cta .eyebrow {
    color: var(--cream);
  }

  .partner-cta h2,
  .partner-cta p {
    color: var(--white);
  }

  .partner-cta .lead {
    color: color-mix(in srgb, var(--white) 88%, var(--cream));
  }

  @media (max-width: 1100px) {
    .tile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .about-grid,
    .categories-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 560px) {
    .tile-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
