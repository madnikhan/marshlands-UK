---
interface HeroVideo {
  id: string;
  mp4: string;
  webm?: string;
  poster: string;
  label: string;
}

interface Props {
  videos: HeroVideo[];
}

const { videos } = Astro.props;
const firstPoster = videos[0]?.poster ?? '';
---

<div class="hero-video-loop" data-hero-video-loop>
  <img class="hero-poster" src={firstPoster} alt="" loading="eager" decoding="async" aria-hidden="true" />
  {
    videos.map((video, index) => (
      <video
        class:list={['hero-video', { 'is-active': index === 0 }]}
        data-hero-video
        muted
        playsinline
        autoplay={index === 0}
        preload="auto"
        poster={video.poster}
        aria-label={video.label}
      >
        <source src={video.mp4} type="video/mp4" />
        {video.webm ? <source src={video.webm} type="video/webm" /> : null}
      </video>
    ))
  }
  <div class="scrim" aria-hidden="true"></div>
</div>

<style>
  .hero-video-loop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--cream-light);
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-poster {
    z-index: 0;
  }

  .hero-video {
    opacity: 0;
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
  }

  .hero-video.is-active {
    opacity: 1;
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(
        105deg,
        color-mix(in srgb, var(--cream-light) 78%, transparent) 0%,
        color-mix(in srgb, var(--cream-light) 35%, transparent) 48%,
        color-mix(in srgb, var(--maroon) 16%, transparent) 100%
      ),
      linear-gradient(to top, color-mix(in srgb, var(--cream-light) 55%, transparent), transparent 55%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
</style>

<script>
  function initHeroVideoLoop() {
    const root = document.querySelector('[data-hero-video-loop]');
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-hero-video]'));
    if (videos.length < 1) return;

    let index = 0;
    let switching = false;

    const warm = (video: HTMLVideoElement) => {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('muted', '');
      video.preload = 'auto';
      try {
        video.load();
      } catch {
        /* ignore */
      }
    };

    videos.forEach(warm);

    const activate = async (next: number) => {
      if (switching) return;
      switching = true;
      const current = videos[next];
      if (!current) {
        switching = false;
        return;
      }

      if (current.readyState < 2) {
        await new Promise<void>((resolve) => {
          const done = () => {
            current.removeEventListener('canplay', done);
            resolve();
          };
          current.addEventListener('canplay', done, { once: true });
          current.load();
          window.setTimeout(resolve, 4000);
        });
      }

      try {
        current.currentTime = 0;
      } catch {
        /* ignore seek errors before metadata */
      }

      try {
        await current.play();
      } catch {
        /* autoplay can still fail; keep trying next cycle */
      }

      videos.forEach((video, i) => {
        const active = i === next;
        video.classList.toggle('is-active', active);
        if (!active) {
          video.pause();
        }
      });

      index = next;
      switching = false;
    };

    const advance = () => {
      if (switching) return;
      const next = (index + 1) % videos.length;
      void activate(next);
    };

    videos.forEach((video) => {
      video.addEventListener('ended', () => {
        if (video.classList.contains('is-active')) advance();
      });
    });

    void activate(0);
  }

  initHeroVideoLoop();
  document.addEventListener('astro:page-load', initHeroVideoLoop);
</script>
