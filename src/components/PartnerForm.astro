<form class="form js-form" method="POST" action="/send-mail.php" novalidate>
  <input type="hidden" name="form_type" value="partner" />
  <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

  <div class="form-row form-row--2">
    <label>
      Company name
      <input type="text" name="company" required placeholder="Your company" />
    </label>
    <label>
      Country
      <input type="text" name="country" required autocomplete="country-name" placeholder="e.g. China" />
    </label>
  </div>

  <div class="form-row form-row--2">
    <label>
      Contact name
      <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
    </label>
    <label>
      Email
      <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
    </label>
  </div>

  <label>
    Partnership type
    <select name="partnership_type" required>
      <option value="">Select an option</option>
      <option value="Manufacturer / OEM / ODM">Manufacturer / OEM / ODM</option>
      <option value="Distributor / Wholesale">Distributor / Wholesale</option>
      <option value="Brand collaboration">Brand collaboration</option>
      <option value="Other">Other</option>
    </select>
  </label>

  <label>
    Message
    <textarea
      name="message"
      required
      placeholder="Tell us about your business, your main product categories and how you would like to work with MARSHLAND. You may also include information about customisation, minimum order quantities and lead times."></textarea>
  </label>

  <button class="btn btn--primary" type="submit">Send Partnership Enquiry</button>
  <p class="form-status" aria-live="polite"></p>
</form>

<style>
  .botcheck {
    display: none !important;
  }
</style>

<script>
  function initForms() {
    document.querySelectorAll('.js-form').forEach((formEl) => {
      const form = formEl as HTMLFormElement;
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.querySelector('.form-status') as HTMLElement | null;
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const formType = (form.querySelector('input[name="form_type"]') as HTMLInputElement | null)
          ?.value;

        if (!form.checkValidity()) {
          form.reportValidity();
          if (status) {
            status.textContent = 'Please fill in all required fields.';
            status.className = 'form-status form-status--error';
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (status) {
          status.textContent = 'Sending…';
          status.className = 'form-status';
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const data = await response.json();

          if (response.ok && data.success) {
            form.reset();
            if (status) {
              status.textContent =
                formType === 'partner'
                  ? 'Thank you — your partnership enquiry has been sent successfully. We will get back to you shortly.'
                  : 'Thank you — your message has been sent successfully. We will get back to you shortly.';
              status.className = 'form-status form-status--success';
              status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          } else {
            throw new Error(data.message || 'Unable to send message');
          }
        } catch (err) {
          if (status) {
            status.textContent =
              err instanceof Error && err.message
                ? err.message
                : 'Something went wrong. Please try again or email us directly.';
            status.className = 'form-status form-status--error';
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  }

  initForms();
  document.addEventListener('astro:page-load', initForms);
</script>
