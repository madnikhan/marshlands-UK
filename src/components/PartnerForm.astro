---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---

<form class="form js-form" method="POST" action="https://api.web3forms.com/submit" novalidate>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="MARSHLAND partnership enquiry" />
  <input type="hidden" name="from_name" value="MARSHLAND Partner Form" />
  <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

  <div class="form-row form-row--2">
    <label>
      Company name
      <input type="text" name="company" required placeholder="Your company" />
    </label>
    <label>
      Country
      <input type="text" name="country" required autocomplete="country-name" placeholder="e.g. China" />
    </label>
  </div>

  <div class="form-row form-row--2">
    <label>
      Contact name
      <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
    </label>
    <label>
      Email
      <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
    </label>
  </div>

  <label>
    Partnership type
    <select name="partnership_type" required>
      <option value="">Select an option</option>
      <option value="Manufacturer / OEM / ODM">Manufacturer / OEM / ODM</option>
      <option value="Distributor / Wholesale">Distributor / Wholesale</option>
      <option value="Brand collaboration">Brand collaboration</option>
      <option value="Other">Other</option>
    </select>
  </label>

  <label>
    Message
    <textarea
      name="message"
      required
      placeholder="Tell us about your company, products, and how you would like to partner"></textarea>
  </label>

  <button class="btn btn--primary" type="submit">Submit partnership enquiry</button>
  <p class="form-status" aria-live="polite"></p>
  {
    !accessKey && (
      <p class="form-note">
        Form delivery requires a Web3Forms access key. Add <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code> to
        your environment before go-live.
      </p>
    )
  }
</form>

<style>
  .botcheck {
    display: none !important;
  }

  .form-note {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  code {
    font-size: 0.85em;
  }
</style>

<script>
  function initForms() {
    document.querySelectorAll('.js-form').forEach((formEl) => {
      const form = formEl as HTMLFormElement;
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.querySelector('.form-status') as HTMLElement | null;
        const accessKey = (form.querySelector('input[name="access_key"]') as HTMLInputElement | null)
          ?.value;
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

        if (!accessKey) {
          if (status) {
            status.textContent =
              'Form is not configured yet. Please email info@marshlands.co.uk or sourcing@marshlands.co.uk.';
            status.className = 'form-status form-status--error';
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (status) {
          status.textContent = 'Sending…';
          status.className = 'form-status';
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const data = await response.json();

          if (response.ok && data.success) {
            form.reset();
            if (status) {
              status.textContent = 'Thank you. Your partnership enquiry has been sent.';
              status.className = 'form-status form-status--success';
            }
          } else {
            throw new Error(data.message || 'Unable to send message');
          }
        } catch {
          if (status) {
            status.textContent = 'Something went wrong. Please try again or email us directly.';
            status.className = 'form-status form-status--error';
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  }

  initForms();
  document.addEventListener('astro:page-load', initForms);
</script>
