---
import type { Product } from '../data/products';

interface Props {
  product: Product;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { product, class: className, loading = 'lazy' } = Astro.props;
---

<article class:list={['product', className]}>
  <div class="product-media">
    <img src={product.image} alt={product.name} loading={loading} decoding="async" />
  </div>
  <div class="product-body">
    <div class="product-meta">
      <span class="eyebrow">{product.category}</span>
      {
        product.status === 'coming-soon' ? (
          <span class="status">Coming soon</span>
        ) : product.rating ? (
          <span class="status">{product.rating}★ on Amazon</span>
        ) : null
      }
    </div>
    <h3>{product.name}</h3>
    <p>{product.shortDescription}</p>
    <ul>
      {product.features.slice(0, 4).map((feature) => <li>{feature}</li>)}
    </ul>
    {
      product.status === 'live' ? (
        <a class="btn btn--primary" href={product.amazonUrl} target="_blank" rel="noopener noreferrer">
          Buy on Amazon
        </a>
      ) : (
        <a class="btn btn--secondary" href="/partner">
          Enquire about supply
        </a>
      )
    }
  </div>
</article>

<style>
  .product {
    display: grid;
    gap: 1.15rem;
    align-content: start;
    height: 100%;
  }

  .product-media {
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--cream) 80%, white), transparent 55%),
      linear-gradient(160deg, var(--cream-light), color-mix(in srgb, var(--cream) 55%, white));
    aspect-ratio: 1;
  }

  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product:hover .product-media img {
    transform: translateY(-4px) scale(1.04);
  }

  .product-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.2rem;
  }

  .status {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--maroon);
  }

  h3 {
    margin: 0 0 0.4rem;
  }

  p {
    margin: 0;
    color: var(--ink-soft);
  }

  ul {
    margin: 0.85rem 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }

  li + li {
    margin-top: 0.3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-media img {
      transition: none;
    }

    .product:hover .product-media img {
      transform: none;
    }
  }
</style>
