---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="tile">
  <a
    class="tile-link"
    href={product.amazonUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Shop ${product.name} on Amazon`}
  >
    <div class="tile-media">
      <img src={product.image} alt={product.name} loading="lazy" decoding="async" />
    </div>
    <div class="tile-body">
      <h3>{product.name}</h3>
      <p>{product.shortDescription}</p>
      <span class="tile-cta">Buy on Amazon</span>
    </div>
  </a>
</article>

<style>
  .tile {
    min-width: 0;
  }

  .tile-link {
    display: grid;
    gap: 1rem;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .tile-media {
    aspect-ratio: 1;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--cream) 80%, white), transparent 55%),
      linear-gradient(160deg, var(--cream-light), color-mix(in srgb, var(--cream) 55%, white));
    border: 1px solid var(--border);
  }

  .tile-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile:hover .tile-media img {
    transform: translateY(-6px) scale(1.04);
  }

  .tile-body {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .tile-body h3 {
    margin: 0;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.2;
  }

  .tile-body p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tile-cta {
    margin-top: 0.35rem;
    justify-self: start;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--maroon);
    border-bottom: 1px solid color-mix(in srgb, var(--maroon) 45%, transparent);
    padding-bottom: 0.1rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .tile:hover .tile-cta {
    color: var(--maroon-deep);
    border-color: var(--maroon-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-media img {
      transition: none;
    }

    .tile:hover .tile-media img {
      transform: none;
    }
  }
</style>
