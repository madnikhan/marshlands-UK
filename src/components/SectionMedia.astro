---
interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<figure class:list={['section-media', 'reveal', className]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
</figure>

<style>
  .section-media {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--cream) 40%, var(--cream-light));
    box-shadow: var(--shadow-soft);
  }

  .section-media img {
    width: 100%;
    height: 100%;
    min-height: 16rem;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section-media:hover img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-media img {
      transition: none;
    }

    .section-media:hover img {
      transform: none;
    }
  }
</style>
