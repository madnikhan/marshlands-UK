---
import { company, navLinks } from '../data/company';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/images/logo.png" alt={company.brand} width="240" height="40" />
      <p>
        {company.brand} is the trading brand of {company.legalName}, a United Kingdom registered
        company.
      </p>
      <a class="amazon-link" href={company.amazonStoreUrl} target="_blank" rel="noopener noreferrer">
        Visit our Amazon store
      </a>
    </div>

    <div>
      <h3>Explore</h3>
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        <li>
          <a href="/partner">Become a Partner</a>
        </li>
        <li>
          <a href="/privacy">Privacy</a>
        </li>
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <ul>
        <li>
          <strong>General Enquiries</strong>
          <a href={`mailto:${company.emails.general}`}>{company.emails.general}</a>
        </li>
        <li>
          <strong>Partnership Enquiries</strong>
          <a href={`mailto:${company.emails.partnership}`}>{company.emails.partnership}</a>
        </li>
        <li>
          <strong>Address</strong>
          <span>{company.address}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>{company.copyright(new Date().getFullYear())}</p>
    <p>{company.websiteDisplay}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xl);
    padding: var(--space-xl) 0 var(--space-lg);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--cream) 70%, var(--cream-light)) 0%,
        color-mix(in srgb, var(--cream) 90%, var(--slate-mist)) 100%
      );
    border-top: 1px solid var(--border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-brand img {
    height: 2.75rem;
    width: auto;
    max-width: 14rem;
    margin-bottom: 1rem;
    object-fit: contain;
    object-position: left center;
  }

  .footer-brand p {
    max-width: 24rem;
    margin-bottom: 1rem;
  }

  .amazon-link {
    color: var(--maroon);
    font-weight: 600;
    text-decoration: none;
  }

  .amazon-link:hover {
    text-decoration: underline;
  }

  h3 {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  li,
  li a,
  li span {
    color: var(--ink-soft);
    text-decoration: none;
  }

  li a:hover {
    color: var(--maroon);
  }

  li strong {
    display: block;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
